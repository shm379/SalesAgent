# LLM (OpenAI-compatible proxy, e.g. AvalAI / MetisAI)
LLM_BASE_URL=https://api.avalai.ir/v1
LLM_API_KEY=your-proxy-api-key
LLM_MODEL=gpt-4o-mini

# Embeddings: "proxy" tries LLM_BASE_URL first, falls back to "local" automatically
# if it fails. Set to "local" to force the local sentence-transformers model.
EMBEDDING_PROVIDER=proxy
EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Telegram
TELEGRAM_BOT_TOKEN=your-botfather-token

# Storage paths (relative to project root)
PRODUCTS_CSV_PATH=data/products_500.csv
CHROMA_DIR=chroma_db
SQLITE_PATH=checkpoints.sqlite
BOT_THREADS_SQLITE_PATH=bot_threads.sqlite

# Follow-up job durations in seconds. Defaults = 1 hour / 2 days.
# Override with small values (e.g. 30 / 120) for local testing.
NUDGE_DELAY_SECONDS=3600
REOFFER_DELAY_SECONDS=172800
